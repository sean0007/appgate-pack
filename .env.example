# Canonical origin for og:url, canonical, and copied /check links.
# Unset defaults to https://appgate-pack.vercel.app.
# Local override: NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Optional stubs — click magnets work without these.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_KIT=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_OVERNIGHT=

# Optional https endpoint for digest signups only.
# Unset, blank, or non-https: POST /api/digest returns 200 and stores nothing server-side.
DIGEST_WEBHOOK_URL=

# Optional: POST JSON for overnight intake to email/Zapier/Make.
# If unset, records still write under data/submissions/ or /tmp/appgate-submissions.
SUBMISSION_WEBHOOK_URL=
