# Public site URL used in metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Payment Links (Dashboard → Payment Links). Leave unset to show
# “Checkout coming soon — leave email on overnight form.”
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_KIT=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_OVERNIGHT=

# Optional: POST JSON submissions here (email provider, Zapier, Make, etc.).
# If unset, submissions are still written under data/submissions/ (local)
# or /tmp/appgate-submissions (serverless fallback).
SUBMISSION_WEBHOOK_URL=
